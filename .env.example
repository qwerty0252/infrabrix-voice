# Required for Voice Mode. Server-side only: the browser only ever gets a
# short-lived, single-use token minted from this key.
ASSEMBLYAI_API_KEY=

# Which model plans Brix's tool calls.
#   scripted   deterministic offline planner (no key needed, the default)
#   openai | openrouter | gemini | groq   any OpenAI-compatible provider
LLM_PROVIDER=scripted
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Signs demo sign-in tokens. Change it for any shared deployment.
INFRABRIX_AUTH_SECRET=dev-only-change-me

# How long the simulated rollback deployment takes (seconds).
INFRABRIX_DEMO_ROLLBACK_SECONDS=8

# Host ports for docker compose (change if 8000/3000 are taken).
BACKEND_PORT=8000
FRONTEND_PORT=3000
